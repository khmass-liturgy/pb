rules_version = '2';

// 온라인 상담·진단·컨설팅 게시글(premium_board/{boardType}/{uid}/{postId}/...)의
// 접근 제어. 회원 개인정보·농장 사진이 섞여 있어 본인과 관리자만 읽고 쓸 수
// 있어야 한다 — index.html의 PREMIUM_BOARDS/renderBoardPanel이 이 경로를 쓴다.
//
// 관리자 이메일은 functions/index.js의 ADMIN_EMAILS와 같은 목록이다. 둘 중
// 하나만 바꾸면 불일치가 생기니, 관리자를 추가/제거할 때는 두 곳 다 고치고
// (여기는 firebase deploy --only storage, 함수는 firebase deploy --only functions
// 로) 다시 배포해야 한다.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in ["trsumun@gmail.com", "trsumun@daum.net"];
    }
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // 승인된(결제한) 회원인지 — Firebase Auth 커스텀 클레임으로 판단한다.
    // premium/approved.json(공개 GitHub 저장소, 이메일·만료일만)이 "누가
    // 회원인지"의 원본이고, 회원을 추가/수정할 때마다 그 정보를 바탕으로
    // Cloud Function(setMemberApproval)이 이 클레임을 심어준다 — 여기서
    // 직접 approved.json을 읽을 수는 없어서(스토리지 규칙은 다른 파일 내용을
    // 볼 수 없다) 클레임이 유일한 판단 기준이다. 클레임은 로그인/토큰 갱신
    // 시점에 반영되므로, 방금 승인된 회원은 재로그인해야 접근된다.
    function isApprovedMember() {
      return request.auth != null && request.auth.token.approved == true;
    }

    match /premium_board/{boardType} {
      allow list: if isAdmin();
    }
    match /premium_board/{boardType}/{uid} {
      allow list: if isOwner(uid) || isAdmin();
    }
    match /premium_board/{boardType}/{uid}/{postId} {
      allow list: if isOwner(uid) || isAdmin();

      match /{fileName=**} {
        // 사진 용량 제한(15MB) — index.html 쪽 제한(MAX_PHOTO_MB)과 별개로
        // 서버 쪽에서도 한 번 더 막는다.
        allow read: if isOwner(uid) || isAdmin();
        allow write: if (isOwner(uid) || isAdmin())
          && request.resource.size < 15 * 1024 * 1024;
      }
    }

    // 회원 개인정보(이름·전화번호·가입일). premium/approved.json(공개 GitHub
    // 저장소)에는 승인 체크에 필요한 이메일·만료일만 남기고, 실제 개인정보는
    // 여기 관리자만 읽고 쓸 수 있는 곳에 둔다 — 회원 본인도 읽을 필요가 없는
    // 정보라(회원관리 화면은 관리자 전용) admin만 허용한다.
    match /premium_members {
      allow list: if isAdmin();
    }
    match /premium_members/{email}/{fileName=**} {
      allow read, write: if isAdmin();
    }

    // 유료 콘텐츠(상황별 처방·계절별 패키지·농장 맞춤 찾기·자가진단) —
    // 예전엔 공개 GitHub 저장소에 있어서 로그인 없이도 URL만 알면 누구나
    // 볼 수 있었다. 승인된 회원(또는 관리자)만 읽을 수 있게 여기로 옮긴다.
    // 쓰기(발행)는 관리자만 — 이제 이 콘텐츠들은 GitHub PAT이 아니라
    // Firebase 관리자 계정으로 발행한다.
    match /premium_content/{dataset}/{fileName} {
      allow read: if isApprovedMember() || isAdmin();
      allow write: if isAdmin();
    }

    // 그 외 경로는 전부 차단(기본값과 동일하지만 명시적으로 남긴다).
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
